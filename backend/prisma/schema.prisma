generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   // "FARMER", "RETAILER", or "HUB"
  products  Product[]
  orders    Order[]
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  price            Float
  unit             String
  quantity         Int
  imageUrl         String?  // New field for product photo
  sourceFarmerName String?  // Used when a HUB adds products for a farmer without a smartphone
  farmer           User     @relation(fields: [farmerId], references: [id])
  farmerId         Int
  orders           Order[]
}

model Order {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  buyer     User     @relation(fields: [buyerId], references: [id])
  buyerId   Int
  quantity  Int
  total     Float
  status    String   // "PENDING", "COMPLETED", "CANCELLED"
  createdAt DateTime @default(now())
}
