generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String?
  role         String   // "FARMER", "RETAILER", "HUB", "ADMIN", "DRIVER", "STOCK_MANAGER", or "SALES_REP"
  products     Product[]
  orders       Order[]
  placedOrders Order[]  @relation("OrderPlacer")
  deliveries   Delivery[] @relation("DriverDeliveries")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  price            Float
  unit             String
  quantity         Int
  imageUrl         String?
  sourceFarmerName String?
  farmer           User     @relation(fields: [farmerId], references: [id])
  farmerId         Int
  orders           Order[]
  storageRecords   StorageRecord[]
}

model Order {
  id           Int      @id @default(autoincrement())
  product      Product  @relation(fields: [productId], references: [id])
  productId    Int
  buyer        User?    @relation(fields: [buyerId], references: [id])
  buyerId      Int?
  placedBy     User?    @relation("OrderPlacer", fields: [placedById], references: [id])
  placedById   Int?
  retailerName String?
  quantity     Int
  total        Float
  status       String   // "PENDING", "COMPLETED", "CANCELLED"
  createdAt    DateTime @default(now())
  delivery     Delivery?
}

model Transport {
  id              Int      @id @default(autoincrement())
  vehicleType     String
  plateNumber     String?
  capacity        Float
  status          String   // "AVAILABLE", "IN_TRANSIT", "MAINTENANCE"
  currentLocation String?
  deliveries      Delivery[]
}

model Storage {
  id            Int      @id @default(autoincrement())
  name          String
  location      String
  capacity      Float
  currentLoad   Float    @default(0)
  records       StorageRecord[]
}

model StorageRecord {
  id            Int      @id @default(autoincrement())
  storage       Storage  @relation(fields: [storageId], references: [id])
  storageId     Int
  product       Product  @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Int
  entryDate     DateTime @default(now())
  exitDate      DateTime?
}

model Delivery {
  id            Int      @id @default(autoincrement())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       Int      @unique
  transport     Transport? @relation(fields: [transportId], references: [id])
  transportId   Int?
  driver        User?    @relation("DriverDeliveries", fields: [driverId], references: [id])
  driverId      Int?
  status        String   // "PENDING", "PICKED_UP", "DELIVERED"
  estimatedDate DateTime?
  actualDate    DateTime?
}
